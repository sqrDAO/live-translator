# Used by examples/memory-host/server.ts and the Vercel functions in api/. The engine itself never reads an
# API key: the key stays on the server that mints ephemeral tokens.
GEMINI_API_KEY=your-key-here
# Full or bare model id; the engine prefixes `models/` itself. Verify per
# deployment (ADR-001 in README.md) — never assume the pinned one survives.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# Token server port (the example's Vite dev server proxies /api here)
PORT=3001
# Set to `development` to allow the localhost-only stub token when no key is
# configured. Never set in a deployed environment.
APP_ENV=development

# --- Sign-in (api/_auth.ts) ----------------------------------------------------
# Firebase Auth + an approval record per person in Firestore (`users/{uid}`,
# `status: pending | approved | denied`). These are the web app's PUBLIC config
# (Firebase console → Project settings → Your apps), not secrets. A deployment
# missing any of them admits nobody. Locally, leaving FIREBASE_PROJECT_ID unset
# with APP_ENV=development signs you in as dev@localhost on a loopback host.
FIREBASE_PROJECT_ID=sqrdao-live-translator
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=sqrdao-live-translator.firebaseapp.com
FIREBASE_APP_ID=
