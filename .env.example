# Used by examples/memory-host/server.ts only. The engine itself never reads an
# API key: the key stays on the server that mints ephemeral tokens.
GEMINI_API_KEY=your-key-here
# Full or bare model id; the engine prefixes `models/` itself. Verify per
# deployment (ADR-001 in README.md) — never assume the pinned one survives.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# Token server port (the example's Vite dev server proxies /api here)
PORT=3001
# Set to `development` to allow the localhost-only stub token when no key is
# configured. Never set in a deployed environment.
APP_ENV=development
