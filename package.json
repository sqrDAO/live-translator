{
  "name": "@sqrdao/live-translate",
  "version": "0.1.0",
  "description": "Host-agnostic live speech translation engine: browser audio in, merged bilingual utterances out, over two Gemini Live sessions.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./lang/en-vi": {
      "types": "./dist/lang/en-vi.d.ts",
      "import": "./dist/lang/en-vi.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "example": "npm --prefix examples/memory-host run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
