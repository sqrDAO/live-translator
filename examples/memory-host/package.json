{
  "name": "@sqrdao/live-translate-memory-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reference host for @sqrdao/live-translate: an in-memory sink and a page that captures, translates and renders — no cloud service of any kind.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:server": "tsx watch server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sqrdao/live-translate": "file:../..",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
